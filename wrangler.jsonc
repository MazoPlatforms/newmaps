{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mazo-maps",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/generated/places.pmtiles"]
  }
}
