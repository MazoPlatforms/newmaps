{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maps",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "vars": {
    "PMTILES_CHUNK_SIZE": "65536"
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1010",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "VECTOR_TILE_RATE_LIMITER",
      "namespace_id": "1011",
      "simple": { "limit": 1200, "period": 60 }
    }
  ],
  "r2_buckets": [
    {
      "binding": "DATA_BUCKET",
      "bucket_name": "mazo-maps-live-data"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_DATA_REGISTRY",
        "class_name": "LiveDataRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "live-data-v1",
      "new_sqlite_classes": ["LiveDataRegistry"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/generated/places.pmtiles",
      "/generated/places-pmtiles-chunks/*"
    ]
  }
}
