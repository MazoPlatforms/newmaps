{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mazoplatforms.github.io/newmaps/road.schema.json",
  "title": "Mazo Road Segment",
  "type": "object",
  "required": [
    "id",
    "source_id",
    "name",
    "type",
    "coordinates"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "coordinates": {
      "description": "Preserved source coordinate array. Geometry validity is checked by scripts/roads.py; invalid coordinates must be documented in road-exclusions.json.",
      "type": "array"
    },
    "supplementary_maxspeed_evidence": {
      "type": "object",
      "required": [
        "source",
        "source_sha256",
        "osm_id",
        "maxspeed",
        "maxspeed_unit",
        "maxspeed_status",
        "source_tags",
        "match_method",
        "match_evidence"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "osm_id": {
          "type": "string"
        },
        "maxspeed": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "maxspeed_unit": {
          "type": "null",
          "description": "No unit is declared in the supplementary dataset."
        },
        "maxspeed_status": {
          "type": "string",
          "enum": [
            "unverified_source_tag",
            "no_source_tag"
          ]
        },
        "source_tags": {
          "type": "object"
        },
        "match_method": {
          "type": "string"
        },
        "match_evidence": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
