{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mazoplatforms.github.io/newmaps/place.schema.json",
  "title": "Mazo Place",
  "type": "object",
  "required": ["id", "name", "coordinates"],
  "properties": {
    "id": {"type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
    "name": {"type": "string", "minLength": 1},
    "name_original": {"type": "string", "minLength": 1},
    "address_original": {"type": "string"},
    "categories_original": {"type": "array", "items": {"type": "string"}},
    "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"}},
    "source_records": {"type": "array", "items": {"type": "object", "required": ["id", "source", "index"], "properties": {"id": {"type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"}, "source": {"type": "string"}, "index": {"type": "integer", "minimum": 0}, "original_id": {"type": "string"}}, "additionalProperties": false}},
    "coordinates": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "required": ["latitude", "longitude"], "properties": {"latitude": {"type": "number", "minimum": -90, "maximum": 90}, "longitude": {"type": "number", "minimum": -180, "maximum": 180}}, "additionalProperties": true}
      ]
    },
    "coordinates_original": {"type": ["object", "null"], "additionalProperties": true},
    "categories": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "address": {"type": "string"},
    "phone": {"type": "string"},
    "website": {"type": "string"},
    "hours": {"type": "array"},
    "business_status": {"type": "string"}
  },
  "additionalProperties": true
}
